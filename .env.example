# Set these as Supabase Edge Function secrets, not in frontend files.
# Comma-separated exact origins allowed to call the API (no path, no trailing slash).
ALLOWED_ORIGINS=https://aksitas.github.io
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Gmail account that authorized GOOGLE_REFRESH_TOKEN (needs the gmail.send scope).
EMAIL_FROM=
EMAIL_FROM_NAME=AKSITAS Booking
BOOKING_NOTIFICATION_EMAIL=
# Bank transfer details, shown only in the customer's confirmation email (not on the public site).
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_HOLDER=
# WhatsApp number that receives transfer proofs, e.g. 0812xxxxxxxx (converted to a wa.me link).
PAYMENT_WHATSAPP=
# Cloudflare Turnstile secret key (server side). The matching *site* key goes in app.js.
TURNSTILE_SECRET_KEY=
# Admin page password (min. 12 characters). Admin endpoints are disabled until it is set.
ADMIN_PASSWORD=
# Random string; salts hashed IPs/emails used for rate limiting.
RATE_LIMIT_SALT=
# Test environments only: set to true to accept bookings without Turnstile. Never in production.
# ALLOW_UNVERIFIED_BOOKINGS=true
